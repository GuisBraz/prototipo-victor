# Configuração PÚBLICA do app web (valores do console Firebase → Configurações do projeto → Seus apps).
# Copie para .env.local. NUNCA coloque chaves privadas aqui (nada de chave da Anthropic).
VITE_FIREBASE_API_KEY=exemplo-nao-e-uma-chave-real
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Para desenvolvimento local com emuladores (projeto demo, sem nuvem):
# VITE_FIREBASE_PROJECT_ID=demo-mecabom
# VITE_USE_EMULATORS=true
